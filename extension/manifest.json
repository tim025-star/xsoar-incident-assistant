{
  "manifest_version": 3,
  "name": "XSOAR Incident Assistant",
  "version": "2.0.0",
  "description": "Prepare incident-response drafts from the active Cortex XSOAR session.",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "storage"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open XSOAR Incident Assistant"
  },
  "commands": {
    "run-assistant": {
      "suggested_key": {
        "default": "Alt+Shift+X"
      },
      "description": "Prepare a draft from the active XSOAR incident"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
